#!/bin/sh
# ledger — launcher for the cash ledger. Activates .venv when present and hands the arguments to
# cli.main. It contains no business logic.
set -eu

ROOT=$(cd "$(dirname "$0")" && pwd)
if [ -x "$ROOT/.venv/bin/python" ]; then
    PYTHON="$ROOT/.venv/bin/python"
else
    PYTHON=python3
fi
PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$PYTHON" -m cli "$@"
