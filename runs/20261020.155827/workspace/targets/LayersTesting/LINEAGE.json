    "INSTRUCTIONS.md": {
      "state": "current",
      "versions": [
        {
          "commit": "893ba02",
          "date": "2026-10-20",
          "hash": "d9baeaa8c788079479b7b83e217bd052b62a3f15730daff71c19c77bc2926924",
          "release": "",
          "state": "consumed",
          "via": "plan",
          "ticket": null,
          "requirements": [
            {
              "name": "ledger-executable",
              "text": "The product is an executable named `ledger` at the application root.",
              "stories": []
            },
            {
              "name": "persistence-contract",
              "text": "It stores everything in a relational database through the shipped persistence library, and every command either completes in full or changes nothing.",
              "stories": [
                "persistence"
              ]
            },
            {
              "name": "conformance-harness",
              "text": "`sources/run.sh` is the scoring entry point.",
              "stories": [
                "conformance"
              ]
            },
            {
              "name": "command-validation",
              "text": "The contract below is the same for every language and database: the same commands, the same output, and the same exit codes.",
              "stories": [
                "cli-foundation"
              ]
            },
            {
              "name": "schema-lifecycle",
              "text": "`ledger init` | Drops all three tables if present and creates them empty. Nothing written.",
              "stories": [
                "schema-lifecycle"
              ]
            },
            {
              "name": "account-category-load",
              "text": "`ledger load <table> <csv>` | Loads `accounts`, `categories`, or `transactions` from a file whose header matches the table's columns in the order above. Writes `table,loaded` and `<table>,<rows>`.",
              "stories": [
                "account-category-load"
              ]
            },
            {
              "name": "transaction-load",
              "text": "A loaded transaction keeps the `txn_id` from its file.",
              "stories": [
                "transaction-load"
              ]
            },
            {
              "name": "account-operations",
              "text": "`ledger account add <code> <name>` | The new account row.",
              "stories": [
                "account-operations"
              ]
            },
            {
              "name": "transaction-operations",
              "text": "`ledger txn post <account> <category> <amount> <date> [<memo>]` | The new transaction row.",
              "stories": [
                "transaction-operations"
              ]
            },
            {
              "name": "transfers",
              "text": "`ledger transfer <from> <to> <amount> <date>` | Two transaction rows in category `TRANSFER`: `-amount` on `<from>` with memo `transfer to <to>`, then `+amount` on `<to>` with memo `transfer from <from>`. The amount is positive and the accounts differ.",
              "stories": [
                "transfers"
              ]
            },
            {
              "name": "balance-report",
              "text": "`ledger report balances` | `account,name,transactions,balance` per account ordered by code, then `TOTAL,,<count>,<sum>`.",
              "stories": [
                "balance-report"
              ]
            },
            {
              "name": "monthly-report",
              "text": "`ledger report monthly` | `month,transactions,inflow,outflow,net` per `YYYY-MM` that has transactions, ascending, then `TOTAL,<count>,<inflow>,<outflow>,<net>`.",
              "stories": [
                "monthly-report"
              ]
            },
            {
              "name": "category-report",
              "text": "`ledger report categories` | `category,description,transactions,inflow,outflow,net` per category ordered by code, including categories with no transactions, then `TOTAL,,<count>,<inflow>,<outflow>,<net>`.",
              "stories": [
                "category-report"
              ]
            },
            {
              "name": "automated-tests",
              "text": "The completed application provides a POSIX-compatible `bin/test.sh` that runs its own automated test suite from the application root and exits zero only when every test passes.",
              "stories": [
                "project-tests"
              ]
            }
          ]
        }
      ]
    },
